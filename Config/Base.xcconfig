// Build settings shared by every RideOrNah target.
// Personal values (bundle ID prefix, team) go in Local.xcconfig, which is gitignored.

BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
APP_GROUP_IDENTIFIER = group.$(BUNDLE_ID_PREFIX).rideornah

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"
